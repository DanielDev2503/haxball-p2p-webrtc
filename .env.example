# ===================================================================
# CONFIGURACIÓN DE ENTORNO - HAXBALL P2P WEBRTC
# ===================================================================

# Servidores STUN públicos (separados por comas si hay múltiples)
VITE_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Credenciales API REST de Metered.ca (STUN / TURN dinámico)
METERED_DOMAIN=tu-app.metered.ca
METERED_API_KEY=tu_api_key_aqui

# Servidor de señalización WebSockets (WebSocket Gateway)
VITE_SIGNALING_URL=ws://localhost:3000
